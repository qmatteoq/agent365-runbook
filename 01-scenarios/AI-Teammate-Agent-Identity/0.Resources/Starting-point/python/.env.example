# Rename to .env and fill in. This file is safe to commit; .env is gitignored.

# ── Microsoft 365 Agents SDK ─────────────────────────────────────────────────────────
# There is no Azure Bot registration here, so there are no real bot credentials to paste
# in. An AI Teammate's messaging endpoint lives on the Agent 365 blueprint, and
# "a365 setup all --aiteammate --m365" fills these in for you during onboarding.
#
# The empty key below still has to be present. This is a genuine difference from the .NET
# starting point: .NET simply logs "No connections found in configuration" and carries on,
# whereas the Python SDK builds its connection manager eagerly and raises
# "ValueError: No service connection configuration provided." if SERVICE_CONNECTION is
# missing entirely. An empty value is enough to get past that and run anonymously, which
# is what lets the Microsoft 365 Agents Playground talk to the agent over localhost before
# any registration exists.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=

# Lets the agent accept activities that carry no bearer token, which is how the Microsoft
# 365 Agents Playground reaches it over localhost. This is the Python equivalent of the
# empty "TokenValidation:Audiences" array in the .NET starting point.
#
# Set it back to false once onboarding has filled in the credentials above. An anonymous
# agent on a public tunnel will accept any well-formed activity, reach the model and spend
# tokens, and only fail when it tries to reply.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__ANONYMOUS_ALLOWED=true

# ── Azure OpenAI ─────────────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional. Leave this commented out to authenticate with Entra credentials (recommended, and
# the only option in tenants where API keys are disabled by policy). Uncomment and set it to
# use key auth instead. Leave it present-but-empty and the Azure OpenAI client treats it as a
# real (empty) key and fails with "Missing credentials".
# AZURE_OPENAI_API_KEY=
# Tenant that owns the Azure OpenAI resource; pins the Azure CLI credential.
AZURE_OPENAI_TENANT_ID=
# Set to true only when hosted on Azure with a managed identity assigned.
AZURE_OPENAI_USE_MANAGED_IDENTITY=false

# ── Agent ────────────────────────────────────────────────────────────────────────────
LEARN_MCP_ENDPOINT=https://learn.microsoft.com/api/mcp
# 3981 keeps this clear of the other starting points: 3978 (.NET Teams),
# 3979 (Python Teams) and 3980 (.NET teammate).
PORT=3981
