# --- Microsoft 365 Agents SDK -------------------------------------------------------
# There is no Azure Bot resource in this scenario, so there are no bot credentials to
# fill in by hand. a365 setup all writes these three values during Phase 1 of the
# runbook. Leave them empty until then: an empty ClientId is what puts the agent in
# anonymous mode, which is how the Microsoft 365 Agents Playground reaches it locally.
Connections__ServiceConnection__Settings__ClientId=
Connections__ServiceConnection__Settings__ClientSecret=
Connections__ServiceConnection__Settings__TenantId=

# Anonymous mode is refused when NODE_ENV is production, whatever the ClientId says,
# so leave this alone while you are working through Phase 0.
NODE_ENV=development

# --- Azure OpenAI -------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your chat deployment name>
AZURE_OPENAI_API_VERSION=2024-10-21

# Tenant that owns the Azure OpenAI resource. Without it the credential may return a token
# from a different tenant and the service answers HTTP 400.
AZURE_OPENAI_TENANT_ID=

# Optional. Leave blank to authenticate with Entra credentials, which is the recommended
# path and the only one available where API keys are disabled by policy.
AZURE_OPENAI_API_KEY=

# false locally, true when the agent is hosted on Azure with a managed identity.
AZURE_OPENAI_USE_MANAGED_IDENTITY=false

# --- The agent's own settings -------------------------------------------------------
LEARN_MCP_ENDPOINT=https://learn.microsoft.com/api/mcp
PORT=3982
