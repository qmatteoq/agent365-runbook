{
  "version": "2.0.0",
  "tasks": [
    {
      // Keeps node_modules in step with package.json before every run.
      "label": "install dependencies",
      "type": "process",
      "command": "npm",
      "args": ["install"],
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "problemMatcher": []
    },
    {
      // From Phase 1 onward, Teams reaches the agent through this tunnel, so it has to be
      // up before the agent starts.
      //
      // The tunnel is named rather than anonymous on purpose: a named tunnel keeps the same
      // public url every time it is hosted, and that url is registered as the blueprint's
      // messaging endpoint. An anonymous tunnel would hand out a new url on each run and
      // silently break the channel until the endpoint was re-registered with
      // 'a365 setup blueprint --endpoint-only --messaging-endpoint <url>'.
      //
      // Create it once, if it does not exist yet:
      //   devtunnel create nodejs-agent-teammate-tunnel --allow-anonymous
      //   devtunnel port create nodejs-agent-teammate-tunnel --port-number 3982
      // The public url is only printed while hosting; it is NOT derived from the tunnel name.
      "label": "start dev tunnel",
      "type": "process",
      "command": "devtunnel",
      "args": ["host", "nodejs-agent-teammate-tunnel"],
      "isBackground": true,
      // Hosting the same tunnel twice would leave a stray relay process behind on every F5.
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "agent"
      },
      "problemMatcher": {
        "owner": "devtunnel",
        "pattern": [
          {
            "regexp": "^\\s*(?:Error|error):\\s+(.*)$",
            "message": 1
          }
        ],
        // The task never exits, so VS Code is told to treat it as ready once the relay reports
        // it is accepting connections. Without this, F5 would wait on it forever.
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*Hosting port:",
          "endsPattern": "^\\s*Ready to accept connections for tunnel:"
        }
      }
    },
    {
      // The tunnel has to be ready before the agent binds the port, hence the ordered sequence.
      "label": "start agent prerequisites",
      "dependsOn": ["install dependencies", "start dev tunnel"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
