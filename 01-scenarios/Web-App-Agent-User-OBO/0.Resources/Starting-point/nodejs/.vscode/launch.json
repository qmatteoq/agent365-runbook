{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Microsoft Learn agent",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "install dependencies",
      // tsx runs the TypeScript entry point directly, so there is no build step
      // between pressing F5 and the agent starting.
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Listening on (https?://[^ ]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
